{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Анти-бурмалда",
  "description": "Скрывает упоминания азартных игр, баннеры и знакомые рекламные вставки по вашему локальному реестру.",
  "version": "0.5.6",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "declarativeNetRequest", "activeTab", "contextMenus"],
  "commands": {
    "open-editor": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Добавить правило на текущей странице"
    }
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Анти-бурмалда" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": ["catalog.js", "logo-catalog.js", "registry.js", "vision.js", "logomatch.js", "campaign.js", "regions.js", "animation.js", "twitch-cycles.js", "youtube.js", "content.js", "editor.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://*.youtube.com/*", "https://*.youtube-nocookie.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["youtube-player.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/wordmark.svg", "icons/wordmark-compact.svg", "audio/burmalda.wav"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
